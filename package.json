{
  "name": "bloqueador-paginas",
  "version": "1.0.0",
  "description": "Bloqueador de páginas web para Windows, pensado para crear un entorno seguro para niños al navegar.",
  "main": "main.js",
  "author": "Bloqueador de Páginas",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis"
  },
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.bloqueadorpaginas.app",
    "productName": "Bloqueador de Paginas",
    "asar": true,
    "files": [
      "main.js",
      "preload.js",
      "src/**/*",
      "blocklists/**/*",
      "assets/**/*",
      "package.json"
    ],
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": ["x64"]
        }
      ],
      "icon": "assets/icon.ico",
      "requestedExecutionLevel": "requireAdministrator"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": true,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Bloqueador de Paginas"
    }
  }
}
